Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Find", " ", "endpoints", " ", "of", " ", "dangling", " ", "segments"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dangle", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"near", "=", 
       RowBox[{"Nearest", "[", 
        RowBox[{
         RowBox[{"Delete", "[", 
          RowBox[{"listofpixels", ",", "i"}], "]"}], ",", 
         RowBox[{"listofpixels", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"All", ",", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], "}"}]}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "near", "]"}], "==", "1"}], "&&", 
         RowBox[{
